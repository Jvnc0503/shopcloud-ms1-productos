# ==========================================
# Configuración del Entorno (Ejemplo)
# Copia este archivo como '.env' y reemplaza los valores
# ==========================================

# Entorno de ejecución (development, staging, production)
ENVIRONMENT=development

# Modo depuración (True para ver logs detallados y consultas SQL)
DEBUG=True

# ==========================================
# Configuración de Base de Datos MySQL
# ==========================================
# En Docker, el host suele ser el nombre del servicio (ej. 'mysql' o 'vm3-ip')
# En local, suele ser 'localhost' o '127.0.0.1'
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=secret_password_aqui
DB_NAME=shopcloud